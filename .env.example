# WireGuard / AmneziaWG
WG_SERVER_PUBLIC_KEY=your_wg_server_public_key_here
WG_SERVER_ENDPOINT=your_server_ip_or_domain:51820
WG_DNS=1.1.1.1,8.8.8.8
WG_DEFAULT_DNS=1.1.1.1
WG_ALLOWED_IPS=0.0.0.0/0, ::/0

# YooKassa Payment Integration
YOO_KASSA_SHOP_ID=your_shop_id_here
YOO_KASSA_SECRET_KEY=your_yoo_kassa_secret_key_here
YOO_KASSA_TEST_SHOP_ID=your_test_shop_id_here
YOO_KASSA_TEST_SECRET_KEY=your_yoo_kassa_test_secret_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TG_ID=123456789

# Database (MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_USER=vpn_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_DATABASE=vpn

# AmneziaWG Management
AMNEZIA_WG_API_URL=http://127.0.0.1:51821
AMNEZIA_WG_API_PASSWORD=your_amnezia_wg_api_password_here
AMNEZIA_CONTAINER=amneziawg

# 3x-ui / Xray Management
XUI_HOST=http://127.0.0.1:5096
XUI_USERNAME=your_xui_username_here
XUI_PASSWORD=your_xui_password_here
XUI_TOTP_SECRET=your_xui_totp_secret_here
XUI_SUB_PATH=https://sub.example.com:2096

# VLESS & Reality Configuration
VLESS_DOMAIN=vpn.example.com
PORTAL_BASE_URL=https://vpn.example.com/portal
SUB_BASE_URL=https://vpn.example.com/sub
VLESS_PORT=443
VLESS_PATH=/
VLESS_INBOUND_ID=1
VLESS_WS_INBOUND_ID=9
VLESS_REALITY_V1_INBOUND_ID=10
ACTIVE_INBOUND_IDS=1,2,4,10,15,16
VLESS_PBK=your_vless_pbk_here
VLESS_SID=your_vless_sid_here
VLESS_SNI=www.microsoft.com

# VLESS XHTTP Configuration
VLESS_HTTP_PORT=47447
VLESS_XHTTP_PBK=your_vless_xhttp_pbk_here
VLESS_XHTTP_SID=your_vless_xhttp_sid_here
VLESS_HTTP_INBOUND_ID=2

# Protocols & Proxy Ports
HYSTERIA_PORT=4443
MTPROTO_SERVER=vpn.example.com
MTPROTO_PORT=8443
MTPROTO_SECRET=your_mtproto_secret_here

# General Service Settings
SERVER_LOCATION=Germany
SERVER_MONTHLY_COST=1000
REFERRAL_REWARD_DAYS=10
REFERRAL_NEWCOMER_DAYS=10

# SMTP / Mailer (Brevo or similar)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=support@example.com

# Backup Passphrase
BACKUP_PASSPHRASE=your_backup_passphrase_here

# Yandex OAuth
YANDEX_OAUTH_ID=your_yandex_oauth_id_here
YANDEX_OAUTH_SECRET=your_yandex_oauth_secret_here

# Finance API Receipt Integration
FINANCE_API_URL=https://finance.example.com
FINANCE_BOT_USER=your_finance_bot_user_here
FINANCE_BOT_PASS=your_finance_bot_pass_here

# External AI & Threat Intelligence
GEMINI_API_KEY=your_gemini_api_key_here
AGY_INTERNAL_KEY=your_agy_internal_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
