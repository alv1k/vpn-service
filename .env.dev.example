# === DEV Environment ===
# Копировать в .env.dev и заполнить реальными значениями

# === 3x-ui ===
XUI_HOST=https://127.0.0.1:5096/xui_panel_path
XUI_USERNAME=your_xui_username
XUI_PASSWORD=your_xui_password_here
XUI_TOTP_SECRET=YOUR_TOTP_SECRET_KEY
XUI_SUB_PATH=https://example.com:2096

# === Telegram Bot ===
# Получить токен у @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
BOT_USERNAME=your_bot_username
ADMIN_TG_ID=000000000

# === MySQL ===
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_DATABASE=vpn

# === YooKassa ===
YOO_KASSA_SHOP_ID=your_shop_id
YOO_KASSA_SECRET_KEY=test_your_secret_key_here
YOO_KASSA_TEST_SHOP_ID=your_shop_id
YOO_KASSA_TEST_SECRET_KEY=test_your_secret_key_here

# === VLESS ===
VLESS_DOMAIN=example.com
VLESS_PORT=443
VLESS_PATH=/
VLESS_INBOUND_ID=1
VLESS_PBK=your_vless_public_key_here
VLESS_SID=your_vless_sid_here
VLESS_SNI=example.com

# === Hysteria 2 ===
HYSTERIA_PORT=4443
HYSTERIA_INBOUND_ID=4

# === AmneziaWG ===
AMNEZIA_WG_API_URL=http://127.0.0.1:51821
AMNEZIA_WG_API_PASSWORD=your_amnezia_api_password_here
AMNEZIA_CONTAINER=amneziawg

# === WireGuard ===
WG_SERVER_PUBLIC_KEY=your_wg_public_key_here
WG_SERVER_ENDPOINT=127.0.0.1:51820
WG_DNS=1.1.1.1

# === SMTP ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=noreply@example.com

# === MTProto Proxy ===
MTPROTO_SERVER=example.com
MTPROTO_PORT=8443
MTPROTO_SECRET=your_mtproto_secret_here

# === Referral ===
REFERRAL_REWARD_DAYS=10
REFERRAL_NEWCOMER_DAYS=10

# === Server ===
SERVER_LOCATION=Germany
